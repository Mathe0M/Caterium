---
import { getCollection } from 'astro:content';
const all = (await getCollection('gammes')).sort((a, b) => a.data.order - b.data.order);
const outils = all.filter((g) => g.data.kind === 'outil');
const variant = (i: number) => ['', 'gcard--violet', 'gcard--orange'][i] ?? '';
---
<div class="grid grid-3">
  {outils.map((g, i) => (
    <a class={`gcard ${variant(i)} card--link`} href={`/gammes/${g.id}/`}>
      <div class="gcard__in">
        <div class="top">
          <span class="mono k">{g.data.mk} · {g.data.entries === 4 ? '3 entrées et +' : `${g.data.entries} entrée${(g.data.entries ?? 1) > 1 ? 's' : ''}`}</span>
          {g.data.recommended && <span class="reco">Recommandée</span>}
        </div>
        <span class="ports" aria-hidden="true">{Array.from({ length: g.data.entries ?? 1 }).map(() => <i></i>)}</span>
        <h3>{g.data.name}</h3>
        <p>{g.data.short}</p>
        <p class="price">{g.data.price}</p>
        <span class="go">Voir la gamme →</span>
      </div>
    </a>
  ))}
</div>

<style>
  .top { display: flex; justify-content: space-between; align-items: center; gap: .5rem; }
  .k { font-size: .78rem; color: var(--violet-light); }
  .reco { font-family: var(--font-mono); font-size: .72rem; background: var(--orange); color: var(--ink); padding: .2rem .5rem; border-radius: 5px; }
  .ports { display: flex; gap: 6px; margin: 1.2rem 0 .9rem; }
  .ports i { width: 16px; height: 16px; border-radius: 4px; background: #fff; }
  h3 { font-size: 1.9rem; margin-bottom: .35rem; }
  p { color: #d6d0ec; margin: 0 0 1rem; }
  .price { font-family: var(--font-title); font-weight: 700; font-size: 1.2rem; color: #fff; margin-top: auto; }
  .go { font-family: var(--font-title); font-weight: 700; color: var(--orange-light); }
</style>
