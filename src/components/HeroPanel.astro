---
/**
 * Panneau « usine » de l'accueil.
 * Entrées (sources) → briques construites au centre → sorties (destinataires).
 * - cliquer un élément le retire (il revient dans le menu « + ») ;
 * - la case « + » sous chaque colonne ouvre un menu pour choisir l'élément à brancher ;
 * - les fils sont tracés en SVG d'après la position réelle des éléments.
 */
const inputs = ['CRM', 'Logiciels métier', 'E-mails', 'Documentation interne'];
const inputsMore = ['Site internet', 'Tableurs', 'Comptabilité', 'Agenda partagé', 'Formulaires en ligne'];
const modules = ['Tableau de bord', 'Assistant IA', 'Portail client'];
const modulesMore = ['Plateforme de formation', 'Application mobile', 'Plugin de navigateur', 'Carte interactive', 'Générateur de documents'];
const outputs = ['Direction', 'Équipes', 'Clients'];
const outputsMore = ['Expert-comptable', 'Fournisseurs', 'Commerciaux', 'Service client', 'Partenaires'];
---
<div class="panel" data-panel>
  <div class="head mono">
    <span>VOTRE ENTREPRISE</span>
    <span class="state">
      <span class="status" data-status>● EN PRODUCTION</span>
      <span class="info">
        <button type="button" class="info__btn" aria-describedby="prod-tip" aria-label="En savoir plus">?</button>
        <span class="info__tip" role="tooltip" id="prod-tip">Rien d'inventé : chacun de ces exemples tourne déjà réellement en production, en entreprise.</span>
      </span>
    </span>
  </div>
  <p class="sr-only">Schéma interactif : vos sources (CRM, logiciels métier, e-mails, documentation interne, et d'autres à ajouter) alimentent des briques sur mesure (tableau de bord, portail client, et d'autres à ajouter : plateforme de formation, assistant IA, application mobile…), qui servent la direction, les équipes et les clients. Chaque élément peut être ajouté ou retiré.</p>

  <div class="flow" data-flow>
    <svg class="wires" aria-hidden="true" data-svg></svg>

    <div class="col col--in" data-col="in" data-more={JSON.stringify(inputsMore)}>
      <span class="lbl mono">ENTRÉES</span>
      {inputs.map((s) => <button type="button" class="node node--in" data-node="in">{s}</button>)}
      <button type="button" class="slot" data-slot="in" aria-expanded="false" aria-haspopup="true" aria-label="Brancher une source">+ Brancher</button>
      <div class="menu" data-menu="in" hidden></div>
    </div>

    <div class="core" data-core data-col="mod" data-more={JSON.stringify(modulesMore)}>
      <span class="lbl mono">CE QUE JE CONSTRUIS</span>
      {modules.map((m) => <button type="button" class="mod" data-mod>{m}</button>)}
      <button type="button" class="slot slot--mod" data-slot="mod" aria-expanded="false" aria-haspopup="true" aria-label="Ajouter une brique">+ Ajouter</button>
      <div class="menu menu--mod" data-menu="mod" hidden></div>
    </div>

    <div class="col col--out" data-col="out" data-more={JSON.stringify(outputsMore)}>
      <span class="lbl mono">SORTIES</span>
      {outputs.map((s) => <button type="button" class="node node--out" data-node="out">{s}</button>)}
      <button type="button" class="slot" data-slot="out" aria-expanded="false" aria-haspopup="true" aria-label="Ajouter un destinataire">+ Ajouter</button>
      <div class="menu" data-menu="out" hidden></div>
    </div>
  </div>

  <div class="bottom">
    <ul class="promises">
      <li><span aria-hidden="true">✓</span> Une seule saisie</li>
      <li><span aria-hidden="true">✓</span> Tâches automatisées</li>
      <li><span aria-hidden="true">✓</span> Une IA sur mesure</li>
      <li><span aria-hidden="true">✓</span> Données sécurisées</li>
    </ul>
  </div>
</div>

<script>
  const NS = 'http://www.w3.org/2000/svg';
  for (const panel of document.querySelectorAll<HTMLElement>('[data-panel]')) {
    if (panel.dataset.ready) continue;
    panel.dataset.ready = '1';
    const flow = panel.querySelector<HTMLElement>('[data-flow]')!;
    const svg = panel.querySelector<SVGSVGElement>('[data-svg]')!;
    const core = panel.querySelector<HTMLElement>('[data-core]')!;
    const status = panel.querySelector<HTMLElement>('[data-status]')!;

    // Cases « + » : ouvrent un menu pour choisir l'élément à brancher.
    // Cliquer un élément branché le retire, et il revient dans le menu.
    type Side = 'in' | 'out' | 'mod';
    const cid = [...panel.getAttributeNames()].filter((a) => a.startsWith('data-astro-cid'));
    const scope = (el: Element) => cid.forEach((a) => el.setAttribute(a, ''));
    const pools: Record<string, string[]> = {};
    const renders: Record<string, () => void> = {};
    const menus: { slot: HTMLButtonElement; menu: HTMLElement }[] = [];
    const sideOf = (el: HTMLElement): Side => (el.dataset.node as Side) || 'mod';

    function bindNode(el: HTMLElement) {
      el.setAttribute('aria-label', `Retirer : ${el.textContent?.trim()}`);
      el.title = 'Cliquer pour retirer';
      el.addEventListener('click', () => {
        const side = sideOf(el);
        const label = el.textContent?.trim() || '';
        const slot = panel.querySelector<HTMLElement>(`[data-slot="${side}"]`);
        el.remove();
        if (label && !pools[side].includes(label)) pools[side].unshift(label);
        renders[side]();
        draw();
        slot?.focus();
      });
    }
    function closeAll(except?: HTMLElement) {
      menus.forEach(({ slot, menu }) => { if (menu !== except) { menu.hidden = true; slot.setAttribute('aria-expanded', 'false'); } });
    }
    for (const slot of panel.querySelectorAll<HTMLButtonElement>('[data-slot]')) {
      const side = slot.dataset.slot as Side;
      const col = panel.querySelector<HTMLElement>(`[data-col="${side}"]`)!;
      const menu = panel.querySelector<HTMLElement>(`[data-menu="${side}"]`)!;
      pools[side] = JSON.parse(col.dataset.more || '[]');
      menus.push({ slot, menu });
      const render = () => {
        const pool = pools[side];
        menu.replaceChildren();
        for (const item of pool) {
          const opt = document.createElement('button');
          opt.type = 'button'; opt.className = 'opt'; opt.textContent = item; scope(opt);
          opt.addEventListener('click', () => {
            pool.splice(pool.indexOf(item), 1);
            const b = document.createElement('button');
            b.type = 'button';
            if (side === 'mod') { b.className = 'mod node--new'; b.dataset.mod = ''; }
            else { b.className = `node node--${side} node--new`; b.dataset.node = side; }
            b.textContent = item; scope(b);
            col.insertBefore(b, slot);
            bindNode(b);
            menu.hidden = true; slot.setAttribute('aria-expanded', 'false');
            render(); draw(); slot.focus();
          });
          menu.appendChild(opt);
        }
        const other = document.createElement('a');
        other.href = '/contact/'; other.className = 'opt opt--other'; scope(other);
        other.textContent = side === 'in' ? 'Un autre outil ? Écrivez-moi →' : side === 'mod' ? 'Autre chose en tête ? Écrivez-moi →' : 'Quelqu’un d’autre ? Écrivez-moi →';
        menu.appendChild(other);
      };
      renders[side] = render;
      render();
      slot.addEventListener('click', (e) => {
        e.stopPropagation();
        const open = menu.hidden;
        closeAll(menu);
        menu.hidden = !open;
        slot.setAttribute('aria-expanded', String(open));
        if (open) menu.querySelector<HTMLElement>('.opt')?.focus();
      });
      menu.addEventListener('click', (e) => e.stopPropagation());
    }
    panel.querySelectorAll<HTMLElement>('[data-node], [data-mod]').forEach(bindNode);
    document.addEventListener('click', () => closeAll());
    panel.addEventListener('keydown', (e) => {
      if (e.key !== 'Escape') return;
      const open = menus.find(({ menu }) => !menu.hidden);
      if (open) { closeAll(); open.slot.focus(); }
    });

    function center(el: Element, side: 'l' | 'r') {
      const f = flow.getBoundingClientRect(), r = el.getBoundingClientRect();
      return { x: (side === 'r' ? r.right : r.left) - f.left, y: r.top + r.height / 2 - f.top };
    }
    function path(a: { x: number; y: number }, b: { x: number; y: number }, on: boolean) {
      const p = document.createElementNS(NS, 'path');
      const dx = (b.x - a.x) * 0.55;
      p.setAttribute('d', `M${a.x} ${a.y} C${a.x + dx} ${a.y} ${b.x - dx} ${b.y} ${b.x} ${b.y}`);
      p.setAttribute('class', on ? 'flow-wire on' : 'flow-wire');
      svg.appendChild(p);
    }

    function draw() {
      const f = flow.getBoundingClientRect();
      svg.setAttribute('viewBox', `0 0 ${f.width} ${f.height}`);
      svg.replaceChildren();
      const ins = [...panel.querySelectorAll('[data-node="in"]')];
      const outs = [...panel.querySelectorAll('[data-node="out"]')];
      const mods = [...panel.querySelectorAll('[data-mod]')];
      const cr = core.getBoundingClientRect();
      const nIn = ins.length, nMod = mods.length;
      const live = nIn > 0 && nMod > 0;
      ins.forEach((el, i) => {
        const y = cr.top - f.top + 30 + (i + 0.5) * ((cr.height - 40) / ins.length);
        path(center(el, 'r'), { x: cr.left - f.left, y }, true);
      });
      outs.forEach((el, i) => {
        const y = cr.top - f.top + 30 + (i + 0.5) * ((cr.height - 40) / outs.length);
        path({ x: cr.right - f.left, y }, center(el, 'l'), live);
      });
      core.classList.toggle('idle', !live);
      panel.style.setProperty('--speed', `${Math.max(0.35, 1.3 - nIn * 0.18)}s`);
      status.textContent = live ? '● EN PRODUCTION' : '○ EN ATTENTE';
      status.classList.toggle('off', !live);
    }

    draw();
    new ResizeObserver(draw).observe(flow);
    document.fonts?.ready.then(draw);
  }
</script>

<style>
  .panel {
    --speed: .8s;
    background: var(--ink); color: #fff; border-radius: 22px; padding: 1.4rem;
    box-shadow: 0 30px 60px -30px rgb(18 16 26 / .6);
  }
  .head { display: flex; justify-content: space-between; gap: 1rem; font-size: .75rem; color: #b9b2d6; margin-bottom: 1.2rem; }
  .status { color: var(--ok); }
  .state { display: inline-flex; align-items: center; gap: .45rem; }
  .info { position: relative; display: inline-flex; }
  .info__btn {
    width: 18px; height: 18px; border-radius: 50%; border: 1px solid #5a5275; background: #1f1b2e;
    color: #d6d0ec; font: 700 .7rem/1 var(--font-mono); cursor: help; padding: 0; display: grid; place-items: center;
  }
  .info__btn:hover, .info__btn:focus-visible { border-color: var(--ok); color: #fff; }
  .info__tip {
    position: absolute; z-index: 6; right: -6px; top: calc(100% + 10px); width: 240px;
    background: #fff; color: var(--ink); font: 500 .82rem/1.45 var(--font-text); letter-spacing: 0; text-transform: none;
    padding: .7rem .8rem; border-radius: 10px; box-shadow: 0 18px 40px -12px rgb(0 0 0 / .6);
    opacity: 0; visibility: hidden; transform: translateY(-4px); transition: opacity .15s, transform .15s, visibility .15s;
  }
  .info__tip::before { content: ''; position: absolute; right: 10px; top: -6px; border: 6px solid transparent; border-top: 0; border-bottom-color: #fff; }
  .info:hover .info__tip, .info__btn:focus + .info__tip { opacity: 1; visibility: visible; transform: none; }
  .status.off { color: #b9b2d6; }

  .flow { position: relative; display: grid; grid-template-columns: 1fr minmax(140px, 1.15fr) 1fr; gap: 2.4rem; align-items: center; }
  .wires { position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; overflow: visible; }
  .wires :global(.flow-wire) { fill: none; stroke: #3a3352; stroke-width: 2.5; }
  .wires :global(.flow-wire.on) {
    stroke: var(--orange); stroke-dasharray: 9 5; animation: wire var(--speed) linear infinite;
    filter: drop-shadow(0 0 3px rgb(255 107 26 / .9));
  }
  @keyframes wire { to { stroke-dashoffset: -28; } }

  .lbl { font-size: .62rem; color: #8f88aa; letter-spacing: .06em; }
  .col { position: relative; display: flex; flex-direction: column; gap: .55rem; }
  .node, .slot, .mod {
    position: relative; font: 600 .86rem/1.2 var(--font-text); text-align: left; color: #fff; cursor: pointer;
    border-radius: 10px; padding: .6rem .7rem; transition: opacity .2s, border-color .2s, background .2s;
  }
  .node { background: #1f1b2e; border: 1px solid #3a3352; }
  .node:hover, .mod:hover { border-color: var(--violet-light); }
  .node--out { border-color: var(--orange); box-shadow: 0 0 12px rgb(255 107 26 / .25); }
  .node::after, .mod::after {
    content: '×'; position: absolute; right: .45rem; top: 50%; transform: translateY(-50%);
    font-size: 1rem; line-height: 1; opacity: 0; transition: opacity .15s; color: var(--orange-light);
  }
  .mod::after { color: var(--orange-text); }
  .node:hover::after, .mod:hover::after, .node:focus-visible::after, .mod:focus-visible::after { opacity: 1; }
  .node--new { animation: pop .35s cubic-bezier(.3, 1.6, .5, 1); }
  .slot {
    background: transparent; border: 1.5px dashed #5a5275; color: #b9b2d6; font-weight: 500;
  }
  .slot:hover, .slot[aria-expanded='true'] { border-color: var(--orange-light); color: #fff; }
  .menu {
    position: absolute; z-index: 5; left: 0; right: 0; top: 100%; margin-top: .4rem;
    background: #fff; color: var(--ink); border-radius: 12px; padding: .35rem;
    box-shadow: 0 18px 40px -12px rgb(0 0 0 / .6); display: flex; flex-direction: column; gap: 2px;
    min-width: 170px;
  }
  .col--out .menu { left: auto; }
  .slot--mod { text-align: center; border-color: rgb(255 255 255 / .3); }
  .menu--mod { left: 50%; right: auto; transform: translateX(-50%); }
  .menu[hidden] { display: none; }
  .opt {
    font: 600 .84rem/1.2 var(--font-text); text-align: left; color: var(--ink); background: none; border: 0;
    border-radius: 8px; padding: .55rem .6rem; cursor: pointer; text-decoration: none;
  }
  .opt:hover, .opt:focus-visible { background: var(--violet-soft); color: var(--violet-text); outline: none; }
  .opt--other { border-top: 1px solid var(--line); border-radius: 0 0 8px 8px; margin-top: .2rem; color: var(--orange-text); font-weight: 700; }

  .core {
    position: relative; border-radius: 18px; background: #2a1a6e; padding: .8rem .7rem;
    display: flex; flex-direction: column; gap: .45rem;
    animation: glow 2.6s ease-in-out infinite; transition: background .3s;
  }
  .core .lbl { color: var(--violet-light); text-align: center; margin-bottom: .1rem; }
  .mod { background: #fff; color: var(--ink); border: 1px solid #fff; text-align: center; }
  .core.idle { animation: none; background: #24203a; box-shadow: none; }

  .bottom { margin-top: 1.3rem; }
  .promises { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: .5rem; font-size: .82rem; font-weight: 600; }
  .promises li { background: #1f1b2e; border-radius: 10px; padding: .6rem .45rem; white-space: nowrap; text-align: center; }
  .promises span { color: var(--orange-light); font-weight: 700; }
  .hint { font-size: .66rem; color: #8f88aa; margin: .9rem 0 0; text-align: right; }

  @keyframes pop { from { transform: scale(.85); opacity: 0; } }
  @keyframes glow {
    0%, 100% { box-shadow: 0 0 0 1px #6d3bff, 0 0 18px rgb(109 59 255 / .55), 0 0 48px rgb(109 59 255 / .25); }
    50% { box-shadow: 0 0 0 1px #6d3bff, 0 0 28px rgb(109 59 255 / .8), 0 0 80px rgb(109 59 255 / .35); }
  }
  @media (max-width: 460px) { .promises { grid-template-columns: 1fr; } }
  @media (max-width: 560px) {
    .flow { grid-template-columns: 1fr 1.1fr 1fr; gap: 1.1rem; }
    .node, .slot, .mod { font-size: .72rem; padding: .45rem .45rem; }
    .lbl { font-size: .55rem; }
    .hint { text-align: left; }
  }
</style>
