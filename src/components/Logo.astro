---
/** Logo Caterium « La jauge » : jauge en C, aiguille dans la zone orange. */
interface Props { inverted?: boolean; size?: number; interactive?: boolean }
const { inverted = false, size = 36, interactive = false } = Astro.props;
const ink = inverted ? '#ffffff' : '#12101a';
const seg3 = inverted ? '#b9a6ff' : '#6d3bff';
---
<span class={`logo ${interactive ? 'logo--live' : ''}`} style={`--logo-ink:${ink}`}>
  <svg class="logo__mark" width={size} height={size} viewBox="0 0 64 64" aria-hidden="true" focusable="false">
    <path d="M47.61 46.05A21 21 0 0 1 26.83 52.35" fill="none" stroke={ink} stroke-width="8" />
    <path d="M23.71 51.29A21 21 0 0 1 11.06 33.65" fill="none" stroke={ink} stroke-width="8" />
    <path d="M11.06 30.35A21 21 0 0 1 23.71 12.71" fill="none" stroke={seg3} stroke-width="8" />
    <path d="M26.83 11.65A21 21 0 0 1 47.61 17.95" fill="none" stroke="#ff6b1a" stroke-width="8" />
    <g class="logo__needle">
      <path d="M34.94 33.70L40.50 17.28L29.06 30.30Z" fill={ink} stroke={ink} stroke-width="1.4" stroke-linejoin="round" />
    </g>
    <circle cx="32" cy="32" r="5.2" fill="#ff6b1a" />
  </svg>
  <span class="logo__word">caterium</span>
</span>

<style>
  .logo { display: inline-flex; align-items: center; gap: .5rem; }
  .logo__word {
    font-family: var(--font-title); font-weight: 700; font-size: 1.5rem;
    letter-spacing: -0.035em; color: var(--logo-ink); line-height: 1;
  }
  .logo__needle { transform-origin: 32px 32px; transition: transform .5s cubic-bezier(.3, 1.6, .5, 1); }
  .logo--live:hover .logo__needle { transform: rotate(10deg); }
  :global(html.overclock) .logo__needle { transform: rotate(38deg); animation: needle-shake .12s linear infinite alternate; }
  @keyframes needle-shake { from { transform: rotate(34deg); } to { transform: rotate(40deg); } }
</style>
