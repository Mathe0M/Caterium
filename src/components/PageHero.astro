---
import Breadcrumbs from './Breadcrumbs.astro';
interface Props {
  eyebrow?: string;
  title: string;
  lead?: string;
  crumbs?: { href: string; label: string }[];
}
const { eyebrow, title, lead, crumbs } = Astro.props;
---
<section class="hero">
  <div class="wrap">
    {crumbs && <Breadcrumbs items={crumbs} />}
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h1 set:html={title} />
    {lead && <p class="lead">{lead}</p>}
    <slot />
  </div>
</section>

<style>
  .hero {
    padding-block: clamp(2.5rem, 6vw, 4.5rem) clamp(2.5rem, 5vw, 4rem);
    background-color: var(--bg); background-image: var(--grid); background-size: 32px 32px;
    border-bottom: 2px solid var(--ink);
  }
  h1 { max-width: 20ch; }
</style>
